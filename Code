def CCR_NC2(a1, a2):
    a1 = np.asarray(a1, dtype=np.float64)
    a2 = np.asarray(a2, dtype=np.float64)
    k = match_template(a2, a1, pad_input=True)
    max_corr = np.max(k)
    y_peak, x_peak = np.unravel_index(np.argmax(k), k.shape)
    offset_y = y_peak - a1.shape[0] + 1
    offset_x = x_peak - a1.shape[1] + 1
    return np.array([max_corr, 0, 0, offset_x, offset_y])


def sort_nat(c):
    def convert(text): return int(text) if text.isdigit() else text.lower()

    def alphanum_key(key): return [convert(c) for c in re.split('(\d+)', key)]

    return sorted(c, key=alphanum_key)


def imread_tif(filepath):
    try:
        img = Image.open(filepath)
        return np.asarray(img, dtype=np.float64)
    except Exception as e:
        print(f"Error reading image {filepath}: {e}")
        return None


def imcrop_np(img, crop_rect):
    xmin, ymin, width, height = [int(x) for x in crop_rect]
    ymin_idx = ymin - 1
    ymax_idx = ymin - 1 + height
    xmin_idx = xmin - 1
    xmax_idx = xmin - 1 + width
    rows, cols = img.shape
    ymin_idx = max(0, ymin_idx)
    ymax_idx = min(rows, ymax_idx)
    xmin_idx = max(0, xmin_idx)
    xmax_idx = min(cols, xmax_idx)

    if ymin_idx >= ymax_idx or xmin_idx >= xmax_idx:
        return np.array([])
    return img[ymin_idx:ymax_idx, xmin_idx:xmax_idx]


def imgMovementFind(ccr, file_names, imgRefIndex, range_val, imgCrop, flag):
    x = ccr[:, 3]
    y = ccr[:, 4]
    imgRefIndex_0based = imgRefIndex - 1
    xmin = np.round(np.min(x))
    xmax = np.round(np.max(x))
    index_list = []
    fileIndex = []

    for i in range(int(xmin - x[imgRefIndex_0based]), int(xmax - x[imgRefIndex_0based]) + 1):
        xtemp = x[imgRefIndex_0based] + i
        xpos = np.abs(x - xtemp) <= range_val
        findexI = np.where(xpos)[0]

        yy = y[findexI]
        ypos = np.abs((yy - y[imgRefIndex_0based]) - np.round(yy - y[imgRefIndex_0based])) <= range_val
        findexI_y = findexI[ypos]
        yy1 = yy[ypos]

        if yy1.size == 0:
            continue

        min_yy_diff = int(np.min(yy1 - y[imgRefIndex_0based]))
        max_yy_diff = int(np.max(yy1 - y[imgRefIndex_0based]))

        for j in range(min_yy_diff - 1, max_yy_diff + 2):
            ytemp = y[imgRefIndex_0based] + j
            ypos_final = np.abs(yy1 - ytemp) <= range_val
            findex = findexI_y[ypos_final]

            if len(findex) > 0:
                div = np.sqrt((x[findex] - xtemp) ** 2 + (y[findex] - ytemp) ** 2)
                pos = np.argmin(div)
                index_list.append(
                    [findex[pos] + 1, float(i), float(j), x[findex[pos]], y[findex[pos]], ccr[findex[pos], 0]])
                if flag == 1:
                    fileIndex.append(file_names[findex[pos]])

    index = np.array(index_list, dtype=np.float64)
    result = {'index': index, 'range': range_val}
    Img = {'imgRef': None, 'imgMean': None, 'img': None}

    if flag == 1 and index.size > 0:
        img_list = []
        crop_w, crop_h = imgCrop[2], imgCrop[3]

        for i, file_name in enumerate(fileIndex):
            temp = imread_tif(file_name)
            if temp is None: continue
            new_crop_rect = imgCrop.copy()
            new_crop_rect[0] += int(index[i, 1])
            new_crop_rect[1] += int(index[i, 2])
            try:
                cropped_img = imcrop_np(temp, new_crop_rect)
                if cropped_img.size > 0 and cropped_img.shape == (crop_h, crop_w):
                    img_list.append(cropped_img)
            except Exception as e:
                print(f"Error during image cropping for {file_name}: {e}")

        img_array = np.stack(img_list, axis=2) if img_list else np.array([])

        if img_array.size > 0:
            pos_ref = np.where(index[:, 0] == imgRefIndex)[0]
            if len(pos_ref) > 0:
                pos_ref = pos_ref[0]
                Img['img'] = img_array
                Img['imgMean'] = np.mean(img_array, axis=2)
                Img['imgRef'] = img_array[:, :, pos_ref]
                ccr_mean = CCR_NC2(Img['imgRef'], Img['imgMean'])
                result['ccr'] = ccr_mean[0]
            else:
                Img['img'] = np.array([])
                result['ccr'] = 0.0

        result['Img'] = Img
        result['fileIndex'] = fileIndex

    if index.size > 0:
        pos = np.where((index[:, 1] == 0) & (index[:, 2] == 0))[0]
        if len(pos) > 0:
            pos_ref = pos[0]
            dx_error = (index[:, 3] - index[pos_ref, 3]) - np.round(index[:, 3] - index[pos_ref, 3])
            dy_error = (index[:, 4] - index[pos_ref, 4]) - np.round(index[:, 4] - index[pos_ref, 4])
            index = np.hstack((index, dx_error[:, None], dy_error[:, None]))
            result['index'] = index

    return result


def objective_function(R, xl4b, I):
    residuals = np.dot(xl4b, R) - I
    return np.sum(residuals ** 2)


def evolutionary_algorithm_solve_bh4(xl4b, I, qs1, N_pop, N_gen, F, CR, bh_niter, bh_temp, D=16):
    def obj_wrapper(R):
        return objective_function(R, xl4b, I)

    R_min = np.zeros(D)
    R_max = np.clip(qs1 * 1.5, a_min=1.0, a_max=None)
    bounds = list(zip(R_min, R_max))

    minimizer_kwargs = {"method": "L-BFGS-B", "bounds": bounds}

    X_g = R_min + np.random.rand(N_pop, D) * (R_max - R_min)
    if N_pop > 0:
        X_g[0, :] = qs1

    fitness_g = np.array([obj_wrapper(X) for X in X_g])

    for g in range(N_gen):
        X_g_next = np.copy(X_g)
        fitness_g_next = np.copy(fitness_g)

        sorted_indices = np.argsort(fitness_g)
        X_g = X_g[sorted_indices]
        fitness_g = fitness_g[sorted_indices]

        X_g_bh_enhanced = np.copy(X_g)
        fitness_g_bh_enhanced = np.copy(fitness_g)

        for i in range(N_pop):
            Xi_g = X_g[i]

            bh_result = basinhopping(
                obj_wrapper,
                Xi_g,
                minimizer_kwargs=minimizer_kwargs,
                bh_niter=10,
                niter=bh_niter,
                T=bh_temp,
                disp=False
            )

            Ui_g_step4 = bh_result.x
            fitness_u_step4 = bh_result.fun

            if fitness_u_step4 < fitness_g[i]:
                X_g_bh_enhanced[i] = Ui_g_step4
                fitness_g_bh_enhanced[i] = fitness_u_step4

        for i in range(N_pop):
            Xi_g_current = X_g_bh_enhanced[i]
            fitness_i_current = fitness_g_bh_enhanced[i]

            idxs = [idx for idx in range(N_pop) if idx != i]

            if len(idxs) < 2:
                X_g_next[i] = Xi_g_current
                fitness_g_next[i] = fitness_i_current
                continue

            parent_indices = np.random.choice(idxs, 3, replace=False)
            Xn_g = X_g_bh_enhanced[parent_indices[0]]
            Xo_g = X_g_bh_enhanced[parent_indices[1]]
            Xk_g = X_g_bh_enhanced[parent_indices[2]]

            Ci_g = np.copy(Xi_g_current)
            r = np.random.rand(D)
            crossover_mask = r < CR

            Ci_g[crossover_mask] = r[crossover_mask] * Xi_g_current[crossover_mask] + (1 - r[crossover_mask]) * Xn_g[
                crossover_mask]

            Ci_g = np.clip(Ci_g, R_min, R_max)
            fitness_c = obj_wrapper(Ci_g)

            candidates = [Xi_g_current, Xn_g, Ci_g]
            candidates_fitness = [fitness_i_current, obj_wrapper(Xn_g), fitness_c]

            best_idx = np.argmin(candidates_fitness)
            Ui_g_step5 = candidates[best_idx]
            fitness_u_step5 = candidates_fitness[best_idx]

            Mi_g = Ui_g_step5 + F * (Xo_g - Xk_g)
            Mi_g = np.clip(Mi_g, R_min, R_max)
            fitness_m = obj_wrapper(Mi_g)

            if fitness_m < fitness_u_step5:
                Ui_g_step6 = Mi_g
                fitness_u_step6 = fitness_m
            else:
                Ui_g_step6 = Ui_g_step5
                fitness_u_step6 = fitness_u_step5

            if fitness_u_step6 < fitness_i_current:
                X_g_next[i] = Ui_g_step6
                fitness_g_next[i] = fitness_u_step6
            else:
                X_g_next[i] = Xi_g_current
                fitness_g_next[i] = fitness_i_current

        X_g = X_g_next
        fitness_g = fitness_g_next

    best_idx = np.argmin(fitness_g)
    R_best = X_g[best_idx]
    best_fitness = fitness_g[best_idx]

    return R_best, 0, best_fitness


