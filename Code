    def getTargetArray(self, ccrResult, frameIndex):

        targetRegion = self.targetRegion
        imgCrop = targetRegion['imgCrop']
        srFactor = targetRegion['srFactor']
        range_val = 0.004
        frame = srFactor ** 2

        result_find = imgMovementFind(ccrResult, self.imgfile_paths, frameIndex, range_val, imgCrop, 1)
        index = result_find['index']
        Img = result_find['Img']

        state = 1
        max_iter = 50
        count = 0

        while (index.shape[0] < frame or (state and index.shape[0] > frame * 1.5)) and count < max_iter:
            if index.shape[0] < frame:
                range_val += 0.0005
                state = 0
            else:
                range_val -= 0.0005
                state = 1

            result_find = imgMovementFind(ccrResult, self.imgfile_paths, frameIndex, range_val, imgCrop, 1)
            index = result_find['index']
            Img = result_find['Img']
            count += 1

        if index.shape[0] == 0:
            self.log_info("错误：未找到满足条件的图像帧。请检查参数或ROI。")
            return None

        self.log_info(f"位移查找完成，找到 {index.shape[0]} 帧。最终容差范围: {range_val:.4f}")

        imgCrop_base = imgCrop.copy()
        indexArray = np.tile(imgCrop_base, (index.shape[0], 1)).astype(np.int32)
        indexArray[:, 0] += index[:, 1].astype(np.int32)
        indexArray[:, 1] += index[:, 2].astype(np.int32)

        result = {}
        result['indexArray'] = indexArray
        result['imgArray'] = Img['img']
        result['lrImg'] = Img['imgRef']

        return result

    def ccldisplacement_callback(self):
        if self.targetRegion['imgCrop'] is None:
            self.log_info("请先选择ROI (步骤 2)。")
            return
        if not self.imgfile_paths:
            self.log_info("请先选取文件夹 (步骤 1)。")
            return
        try:
            frameIndex = int(self.referframe_entry.get())
        except ValueError:
            self.log_info("参考帧输入无效。")
            return

        imgCrop = self.targetRegion['imgCrop']
        self.log_info("正在计算各帧之间的相关性及其位移间隔...")
        start_time = time.time()

        ccrResult_list = []
        try:
            imgRef = imread_tif(self.imgfile_paths[frameIndex - 1])
            imgRef_cropped = imcrop_np(imgRef, imgCrop)
        except IndexError:
            self.log_info("错误：参考帧索引超出文件范围。")
            return

        if imgRef_cropped.size == 0 or imgRef is None:
            self.log_info("错误：参考图像读取或裁剪失败，请检查ROI和文件。")
            return

        for i, file_path in enumerate(self.imgfile_paths):
            imgTemp = imread_tif(file_path)
            if imgTemp is None: continue
            ccrResult = CCR_NC2(imgRef_cropped, imgTemp)
            ccrResult_list.append(ccrResult)

        ccrResult = np.array(ccrResult_list)

        self.log_info("完成各帧之间的相关性及其位移间隔计算。")

        frameResult = self.getTargetArray(ccrResult, frameIndex)
        if frameResult is None:
            self.log_info("未能成功筛选出满足条件的图像帧，请尝试重新选择ROI或检查数据。")
            return

        self.LR = frameResult['lrImg']
        self.imgArray = frameResult['imgArray']
        self.indexArray = frameResult['indexArray']

        picnum = len(self.imgfile_paths)
        N = self.imgArray.shape[2]

        self.log_info(f"已经从 {picnum} 张图片中选出 {N} 张，并给出他们的相对位移矩阵")
        self.log_info(f"计算相关并选择帧运行的时间为: {time.time() - start_time:.2f} 秒")
        self.update_image_display(self.LR, title1="选择区域原图", title2="HR 结果")

    def psi_callback(self):
        if self.imgArray is None or self.QE is None:
            self.log_info("请先完成文件夹选择(1)、ROI选择(2)和位移计算(3)，并确保QE数据已加载。")
            return

        try:
            start_time = time.time()

            srFactor_4 = 4
            srFactor_3 = 3
            srFactor_2 = 2

            use_start = int(self.usestart_entry.get())
            use_end = int(self.useend_entry.get())

            N_gen = int(self.ea_gen_entry.get())
            N_pop = int(self.ea_pop_entry.get())
            F_ea = float(self.ea_F_entry.get())
            CR_ea = float(self.ea_CR_entry.get())

            bh_niter = int(self.bh_niter_entry.get())
            bh_temp = float(self.bh_temp_entry.get())

            if N_pop < 4: N_pop = 4
            if N_gen < 1: N_gen = 1
            if F_ea <= 0 or F_ea >= 2: F_ea = 0.5
            if CR_ea < 0 or CR_ea > 1: CR_ea = 0.9
            if bh_niter < 1: bh_niter = 1
            if bh_temp <= 0: bh_temp = 10.0

            qe_key = self.qe_number.get()
            global QE_DATA
            QE = QE_DATA.get(qe_key)
            if QE is None:
                self.log_info(f"错误：未找到QE版本 {qe_key}。请检查 {QE_FILE_PATH} 中的键名。")
                return

            QE_rows, QE_cols = QE.shape
            start_idx = use_start - 1
            end_idx = min(use_end, self.imgArray.shape[2])

            imgArray_sub = self.imgArray[:, :, start_idx: end_idx]
            indexArray_sub = self.indexArray[start_idx: end_idx, :]
            N = imgArray_sub.shape[2]

            if N < 2:
                self.log_info(f"错误：用于重构的帧数太少 ({N} 帧)，请调整起始/结束帧。")
                return

            high, width = imgArray_sub.shape[0], imgArray_sub.shape[1]

            # PSI 像素分割成像重构 4x4 (HR4)

            srFactor = srFactor_4
            bs = srFactor ** 2
            HR_high, HR_width = high * srFactor, width * srFactor
            HR4_result_current = np.zeros((HR_high, HR_width))

            lzxl4bs_4 = np.zeros((N, HR_high, HR_width))
            for num in range(N):
                ix = indexArray_sub[num, :].astype(np.int32)
                ymin_idx = srFactor * (ix[1] - 1)
                ymax_idx = srFactor * (ix[1] - 1 + ix[3])
                xmin_idx = srFactor * (ix[0] - 1)
                xmax_idx = srFactor * (ix[0] - 1 + ix[2])

                ymin_clip = max(0, ymin_idx)
                ymax_clip = min(QE_rows, ymax_idx)
                xmin_clip = max(0, xmin_idx)
                xmax_clip = min(QE_cols, xmax_idx)

                qe_crop_h = QE[ymin_clip:ymax_clip, xmin_clip:xmax_clip]

                if qe_crop_h.shape == (HR_high, HR_width):
                    lzxl4bs_4[num, :, :] = qe_crop_h
                else:
                    try:
                        qe_resized = resize(qe_crop_h, (HR_high, HR_width), order=1, anti_aliasing=True)
                        lzxl4bs_4[num, :, :] = qe_resized
                    except Exception:
                        lzxl4bs_4[num, :, :] = 1.0

            ydatacr4s_4 = np.zeros((N, HR_high, HR_width))
            for num in range(N):
                ydatacr4s_4[num, :, :] = rescale(imgArray_sub[:, :, num], scale=srFactor, order=0, anti_aliasing=False)

            wybjA4r_4 = np.zeros((HR_high, HR_width))
            for r in range(HR_high):
                for c in range(HR_width):
                    A4 = ydatacr4s_4[:, r, c]
                    if N >= 3:
                        wybjA4r_4[r, c] = (np.sum(A4) - np.max(A4) - np.min(A4)) / (N - 2)
                    elif N == 2:
                        wybjA4r_4[r, c] = np.mean(A4)
                    else:
                        wybjA4r_4[r, c] = A4[0] if N > 0 else 0

            self.update_image_display(self.LR, HR4_result_current, title1="处理前原图 (LR)", title2="4x4 倍标校像素分割成像处理中...")
            self.canvas.draw_idle()

            self.log_info("开始 PSI 像素分割成像拟合 4x4...")

            flag_val_4, erf_val_4 = -1, np.inf

            for n in range(high):
                for m in range(width):
                    I_4 = imgArray_sub[n, m, :] * bs
                    hr_y_start = srFactor * n
                    hr_x_start = srFactor * m
                    xl4b_4 = lzxl4bs_4[:, hr_y_start:hr_y_start + srFactor, hr_x_start:hr_x_start + srFactor].reshape(N,
                                                                                                                      bs)
                    qs1_4 = wybjA4r_4[hr_y_start:hr_y_start + srFactor, hr_x_start:hr_x_start + srFactor].flatten()

                    if not np.all(np.isfinite(xl4b_4)):
                        R_4 = qs1_4
                    else:
                        try:
                            R_4, flag_4, res_norm_4 = evolutionary_algorithm_solve_bh4(
                                xl4b_4, I_4, qs1_4, N_pop, N_gen, F_ea, CR_ea, bh_niter, bh_temp
                            )

                            flag_val_4 = flag_4
                            erf_val_4 = res_norm_4
                        except Exception:
                            R_4 = qs1_4

                    HR4_block = np.clip(R_4.reshape(srFactor, srFactor), a_min=0, a_max=None)
                    HR4_result_current[hr_y_start:hr_y_start + srFactor, hr_x_start:hr_x_start + srFactor] = HR4_block

                if n % 10 == 0 or n == high - 1:
                    self.canvas.draw_idle()

            self.HR4 = HR4_result_current
            self.log_info(f"===== PSI 像素分割成像 4x4 成功完成 ! =====")
            #self.log_info(f"最后拟合结果 (4x4): 最佳残差平方和={erf_val_4:.2e}")

            # PSI 像素分割成像重构 3x3 逻辑

            srFactor = srFactor_3
            bs = srFactor ** 2
            HR_high_3, HR_width_3 = high * srFactor, width * srFactor
