        self.load_qe_data()

    def load_qe_data(self):
        global QE_DATA
        try:
            with np.load(QE_FILE_PATH, allow_pickle=True) as data:
                QE_DATA = {k: v for k, v in data.items()}
                print(f"Loaded QE data from {QE_FILE_PATH}")
                self.QE = QE_DATA.get('lzxl4b')
                if self.QE is None:
                    first_key = next(iter(QE_DATA), None)
                    if first_key:
                        self.QE = QE_DATA[first_key]
                        self.log_info(f"警告：未找到 'lzxl4b'，默认使用第一个键 '{first_key}'。")
                    else:
                        self.log_info("警告：QE数据文件为空。")
        except FileNotFoundError:
            messagebox.showerror("错误", f"未找到QE文件：{QE_FILE_PATH}")
        except Exception as e:
            messagebox.showerror("错误", f"加载QE文件失败：{e}")

