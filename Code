            self.update_image_display(self.LR, self.HR4, title1="处理前原图 (LR)", title2="去除异常解后的像素分割成像图 (EA, 4x4)")

        except Exception as e:
            self.log_info(f"致命错误：PSI 像素分割重构过程中发生未知错误：{e}")
            messagebox.showerror("PSI 像素分割重构错误", f"程序运行中断，请检查数据和QE文件。\n错误信息: {e}")

    def save_pictures_callback(self):
        if self.HR4 is None:
            self.log_info("HR4 图像未生成。")
            return

        path_hr4 = filedialog.asksaveasfilename(defaultextension=".tif",
                                                filetypes=[("TIF files", "*.tif")],
                                                title="保存像素分割成像图片 HR4")
        if path_hr4:
            hr4_uint16 = np.clip(np.round(self.HR4), a_min=0, a_max=65535).astype(np.uint16)
            Image.fromarray(hr4_uint16).save(path_hr4)
            self.log_info(f"HR4 图像已保存至: {path_hr4}")

        if self.LR is not None:
            path_lr = filedialog.asksaveasfilename(defaultextension=".tif",
                                                   filetypes=[("TIF files", "*.tif")],
                                                   title="保存对应的选择区域图片 LR")
            if path_lr:
                lr_uint16 = np.clip(np.round(self.LR), a_min=0, a_max=65535).astype(np.uint16)
                Image.fromarray(lr_uint16).save(path_lr)
                self.log_info(f"LR 图像已保存至: {path_lr}")

    def draw_contrast_callback(self):
        if self.HR4 is None or self.LR is None:
            self.log_info("HR4 或 LR 图像未生成。")
            return

        plt.ion()
        fig_crop, axes_crop = plt.subplots(1, 2)
        axes_crop[0].imshow(self.LR, cmap='gray')
        axes_crop[0].set_title('LR 图像')
        axes_crop[1].imshow(self.HR4, cmap='gray')
        axes_crop[1].set_title('HR4 像素分割成像图')
        fig_crop.suptitle("请在新弹出的图窗上选择 ROI 进行对比度计算 (双击确认)")

        self.contrast_roi = None

        def on_select_contrast(eclick, erelease):
            x1, y1 = eclick.xdata, eclick.ydata
            x2, y2 = erelease.xdata, erelease.ydata
            self.contrast_roi = [min(x1, x2), min(y1, y2), abs(x1 - x2), abs(y1 - y2)]

        def on_double_click_contrast(event):
            if event.inaxes == axes_crop[0] and self.contrast_roi:
                x, y, w, h = [int(np.round(val)) for val in self.contrast_roi]
                A = self.LR[y: y + h, x: x + w].copy()

                srFactor = self.targetRegion['srFactor']
                HR4C = self.HR4[y * srFactor: y * srFactor + h * srFactor,
                       x * srFactor: x * srFactor + w * srFactor].copy()

                if A.size == 0 or HR4C.size == 0:
                    self.log_info("裁剪区域无效。")
                    plt.ioff()
                    plt.close(fig_crop)
                    return

                A = gaussian(A, sigma=0.4)

                ctrA = (np.max(A) - np.min(A)) / (np.max(A) + np.min(A) + 1e-6)
                ctrB = (np.max(HR4C) - np.min(HR4C)) / (np.max(HR4C) + np.min(HR4C) + 1e-6)

                plt.close(fig_crop)

                fig_result, axes_result = plt.subplots(1, 2)
                axes_result[0].imshow(A, cmap='gray')
                axes_result[0].set_title(f"原图像对比度: {ctrA:.4f}")
                axes_result[1].imshow(HR4C, cmap='gray')
                axes_result[1].set_title(f"像素分割成像对比度: {ctrB:.4f}")

                if ctrA > 1e-6:
                    mtf_improvement = (ctrB - ctrA) / ctrA
                else:
                    mtf_improvement = 0.0

                self.log_info(f"LR 对比度: {ctrA:.4f}, HR 对比度: {ctrB:.4f}, MTF 提升: {mtf_improvement:.2%}")

                axes_result[1].text(0, HR4C.shape[0] * 1.05, f"MTF 提升: {mtf_improvement:.2%}",
                                    transform=axes_result[1].transAxes)
                fig_result.tight_layout()
                plt.show(block=False)
                plt.ioff()

            elif event.inaxes and event.dblclick:
                self.log_info("请在 LR 图像 (左图) 上选择 ROI。")

        rs = RectangleSelector(axes_crop[0], on_select_contrast,
                               drawtype='box', useblit=True,
                               button=[1],
                               spancoords='data', interactive=True)

        fig_crop.canvas.mpl_connect('button_press_event',
                                    lambda event: on_double_click_contrast(event) if event.dblclick else None)
        plt.show(block=True)
        plt.ioff()


